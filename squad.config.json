{
  "mainAi": {
    "runner": "claude",
    "model": ""
  },
  "runners": {
    "claude": {
      "type": "claude",
      "label": "Claude Code"
    },
    "startup-ai": {
      "type": "command",
      "label": "모두의창업 지원 솔루션(예시)",
      "cmd": "startup-ai",
      "args": [
        "--prompt",
        "{prompt}"
      ],
      "secret": "STARTUP_AI_KEY"
    }
  },
  "stale": {
    "answerMinutes": 30,
    "idleMinutes": 30
  },
  "budget": {
    "daily": 0,
    "memberDaily": 0,
    "task": 0,
    "warn": 0.8,
    "_note": "0 = 상한 없음. 토큰은 막지 않고 보이게만 한다(2026-10-19 사용자: 한계가 아니라 아끼면서 간다, 한도에 걸리면 계정 전환)"
  },
  "review": {
    "default": "",
    "maxFiles": 30
  },
  "report": {
    "copyTo": ""
  }
}
